# Copy to .env and fill in. All values can also be set as environment variables.

# ── LLM provider ──────────────────────────────────────────────────────────────
# anthropic | openai | mock (offline development only — never demo with mock)
LLM_PROVIDER=openai

# The "openai" provider also drives any OpenAI-compatible endpoint via
# OPENAI_BASE_URL. All four options below were verified against the full
# 15-scenario suite; the ceilings are measured, not guessed.
#
#   DeepSeek (paid, no ceiling — the project default):
#     OPENAI_BASE_URL=https://api.deepseek.com
#     OPENAI_MODEL=deepseek-v4-flash        # 1M context, ~97% prompt-cache hit
#     LLM_MAX_TOKENS=800
#
#   Groq (free key, console.groq.com) — 100k tokens/DAY *per model* (~11 turns);
#   each model has its own budget, so switch models when one is spent:
#     OPENAI_BASE_URL=https://api.groq.com/openai/v1
#     OPENAI_MODEL=openai/gpt-oss-120b      # or llama-3.3-70b-versatile (faster)
#     LLM_MAX_TOKENS=400                    # Groq counts this BEFORE running
#
#   Google Gemini (free key, aistudio.google.com) — only 20 requests/DAY:
#     OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     OPENAI_MODEL=gemini-flash-latest
#
#   Ollama (fully local, no key, no limits — ollama.com):
#     OPENAI_BASE_URL=http://localhost:11434/v1
#     OPENAI_MODEL=gpt-oss:20b
#     Also export OLLAMA_CONTEXT_LENGTH=16384 — the 4k default silently
#     truncates the system prompt and the agent loses its policy rules.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Claude reasoning effort (Claude 4.6+ models): low | medium | high.
LLM_EFFORT=low

# ── Agent loop ────────────────────────────────────────────────────────────────
# Cap on model output per call (on Claude Opus 5 this includes thinking tokens).
# ⚠️ Free tiers validate this against a per-minute token budget BEFORE running,
# so a large value fails every request with HTTP 413. On Groq's free tier
# (8-12k tokens/min) use 1024 — support replies are only a few hundred tokens.
LLM_MAX_TOKENS=16000
# Visible retry attempts for transient LLM failures (rate limit / 5xx / network).
LLM_RETRY_ATTEMPTS=3
# Stream the reply into the chat UI token by token. Providers that can't stream
# fall back to delivering it in one piece, so this only changes how the text
# arrives, never the outcome. Set false to compare, or to cut SSE chatter.
LLM_STREAMING=true
# Safety guard against runaway tool loops.
MAX_TOOL_ITERATIONS=8

# ── Voice: text-to-speech ─────────────────────────────────────────────────────
# Optional. With a key set, agent replies are spoken by ElevenLabs (audio is
# proxied through /api/tts so the key never reaches the browser). Without one,
# the frontend automatically falls back to the browser's built-in speech
# synthesis — voice works either way. Free tier: https://elevenlabs.io
ELEVENLABS_API_KEY=
# Defaults to "Bella" (professional, bright, warm — suits a support agent).
# Voice availability varies by account: run `curl localhost:8000/api/voices`
# to list yours and paste an ID here.
ELEVENLABS_VOICE_ID=hpp4J3VqNfWAUOO0d1Us
# ElevenLabs' documented default. Lower-latency model families exist —
# see https://elevenlabs.io/docs/models
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ── Demo switches ─────────────────────────────────────────────────────────────
# true = the first lookup_customer call in each session fails once with a
# simulated CRM timeout, so the tool-retry path shows up in the reasoning log.
DEMO_SIMULATE_CRM_OUTAGE=false
